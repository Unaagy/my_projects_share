# Виртуальное окружение — у каждого своё, пересоздаётся из requirements.txt
.venv/

# Ключ сервисного аккаунта Google — секрет, в git попадать не должен
credentials.json

# Личные настройки: ID таблицы (шаблон — settings.example.json)
settings.json

# Прогресс изучения: какие карточки и когда отмечены — личные данные
progress.json

# Логи работы скрипта
logs/

# Кэш Python
__pycache__/

# Настройки PyCharm
.idea/

# Данные карточек (отладочные выгрузки и файл для Rainmeter)
*.csv
*.inc
data/
