# Виртуальное окружение — у каждого своё, пересоздаётся из requirements.txt
.venv/

# Ключ сервисного аккаунта Google — секрет, в git попадать не должен
credentials.json

# Логи работы скрипта
logs/

# Кэш Python
__pycache__/

# Настройки PyCharm
.idea/

# Данные из таблицы (отладочные выгрузки и тестовые копии для Rainmeter)
*.csv
*.inc
data/

# Личные настройки: ID таблицы и названия листов (шаблон — settings.example.json)
settings.json
